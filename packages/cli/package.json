{
  "name": "@onboardai/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "onboardai": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit --pretty false",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "test": "pnpm run build && node --test test",
    "onboardai": "node ./dist/index.js"
  },
  "dependencies": {
    "@onboardai/capture": "workspace:*",
    "@onboardai/eval-harness": "workspace:*",
    "@onboardai/fixtures": "workspace:*",
    "@onboardai/flow": "workspace:*"
  }
}
